         self: TerminalFormatter,
         writer: *std.Io.Writer,
     ) std.Io.Writer.Error!void {
+        // A whole-terminal VT dump taken while the alternate screen is active
+        // must also carry the primary screen: a replica that only receives the
+        // alternate screen shows an empty primary screen (and loses its
+        // scrollback) once the full-screen program exits. The primary screen
+        // is written first, then the alternate-screen modes switch over, the
+        // same order a real session produced them in.
+        const primary_screen: ?*const Screen = primary: {
+            if (self.opts.emit != .vt or !self.extra.modes) break :primary null;
+            if (self.pin_map != null) break :primary null;
+            if (self.terminal.screens.active_key != .alternate) break :primary null;
+            switch (self.content) {
+                .none => break :primary null,
+                .selection => |sel| if (sel != null) break :primary null,
+            }
+            break :primary self.terminal.screens.get(.primary);
+        };
