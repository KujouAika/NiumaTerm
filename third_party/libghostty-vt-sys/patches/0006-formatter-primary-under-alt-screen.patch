+fn isAltScreenMode(mode: modespkg.Mode) bool {
+    return switch (mode) {
+        .alt_screen_legacy,
+        .alt_screen,
+        .alt_screen_save_cursor_clear_enter,
+        => true,
+        else => false,
+    };
