+test "TerminalFormatter vt restores primary screen under alternate screen" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var builder: std.Io.Writer.Allocating = .init(alloc);
+    defer builder.deinit();
+
+    var t = try Terminal.init(io, alloc, .{
+        .cols = 20,
+        .rows = 5,
+    });
+    defer t.deinit(alloc);
+
+    var s = t.vtStream();
+    defer s.deinit();
+
+    s.nextSlice("shell$ ls\r\nfile.txt\r\nshell$ ");
+    s.nextSlice("\x1b[?1049h");
+    s.nextSlice("editor view");
+
+    var formatter: TerminalFormatter = .init(&t, .vt);
+    formatter.extra = .all;
+    try formatter.format(&builder.writer);
+
+    var t2 = try Terminal.init(io, alloc, .{
+        .cols = 20,
+        .rows = 5,
+    });
+    defer t2.deinit(alloc);
+
+    var s2 = t2.vtStream();
+    defer s2.deinit();
+
+    s2.nextSlice(builder.writer.buffered());
+
+    try testing.expectEqual(ScreenSet.Key.alternate, t2.screens.active_key);
+    try testing.expectEqual(t.screens.active.cursor.x, t2.screens.active.cursor.x);
+    try testing.expectEqual(t.screens.active.cursor.y, t2.screens.active.cursor.y);
+
+    // Leaving the alternate screen must reveal the same primary screen and
+    // put the cursor back where the shell left it.
+    s.nextSlice("\x1b[?1049l");
+    s2.nextSlice("\x1b[?1049l");
+
+    var original: std.Io.Writer.Allocating = .init(alloc);
+    defer original.deinit();
+    try TerminalFormatter.init(&t, .plain).format(&original.writer);
+
+    var replayed: std.Io.Writer.Allocating = .init(alloc);
+    defer replayed.deinit();
+    try TerminalFormatter.init(&t2, .plain).format(&replayed.writer);
+
+    try testing.expectEqualStrings(original.writer.buffered(), replayed.writer.buffered());
+    try testing.expectEqual(t.screens.active.cursor.x, t2.screens.active.cursor.x);
+    try testing.expectEqual(t.screens.active.cursor.y, t2.screens.active.cursor.y);
+}
