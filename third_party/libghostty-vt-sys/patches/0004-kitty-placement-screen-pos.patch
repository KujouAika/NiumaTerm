diff --git a/src/terminal/c/kitty_graphics.zig b/src/terminal/c/kitty_graphics.zig
index 2bd5e8620..39832f225 100644
--- a/src/terminal/c/kitty_graphics.zig
+++ b/src/terminal/c/kitty_graphics.zig
@@ -505,6 +505,70 @@ pub fn placement_viewport_pos(
     return .success;
 }
 
+/// Get the screen-absolute grid position of the current placement's pin.
+///
+/// Unlike placement_viewport_pos(), this reports the pin's row/column in the
+/// screen coordinate space (history + active area), and does NOT cull
+/// placements that have scrolled out of the viewport. This lets embedders
+/// intersect an off-screen placement with rows they are harvesting into
+/// scrollback history, where the viewport projection is unavailable.
+///
+/// Returns .no_value for virtual (unicode-placeholder) placements, which have
+/// no pin, and when the pin's page has been evicted from the page list.
+pub fn placement_screen_pos(
+    iter_: PlacementIterator,
+    terminal_: terminal_c.Terminal,
+    out_col: *u32,
+    out_row: *u32,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+
+    const wrapper = terminal_ orelse return .invalid_value;
+    const iter = iter_ orelse return .invalid_value;
+    const entry = iter.entry orelse return .invalid_value;
+
+    // A relative placement carries no position of its own: it hangs off a
+    // parent chain whose root supplies the origin and whose links supply the
+    // accumulated offset. A chain rooted at a virtual placement resolves only
+    // against placeholder cells on screen, which this coordinate-space
+    // question cannot answer.
+    const origin: struct {
+        pin: *const PageList.Pin,
+        col_offset: i32 = 0,
+        row_offset: i32 = 0,
+    } = switch (entry.value_ptr.location) {
+        .pin => |pin| .{ .pin = pin },
+        .virtual => return .no_value,
+        .relative => |rel| origin: {
+            const storage = &wrapper.terminal.screens.active.kitty_images;
+            const chain = storage.resolveChain(rel) orelse return .no_value;
+            switch (chain.root.location) {
+                .pin => |root_pin| break :origin .{
+                    .pin = root_pin,
+                    .col_offset = chain.horizontal_offset,
+                    .row_offset = chain.vertical_offset,
+                },
+                .virtual => return .no_value,
+                .relative => unreachable, // resolveChain roots are never relative
+            }
+        },
+    };
+
+    const pages = &wrapper.terminal.screens.active.pages;
+    const pt = pages.pointFromPin(.screen, origin.pin.*) orelse return .no_value;
+
+    // Screen coordinates are unsigned, so a chain offset that lands above or
+    // left of the screen origin has no answer in this space.
+    const col = @as(i32, @intCast(pt.screen.x)) +| origin.col_offset;
+    const row = @as(i32, @intCast(pt.screen.y)) +| origin.row_offset;
+    if (col < 0 or row < 0) return .no_value;
+
+    out_col.* = @intCast(col);
+    out_row.* = @intCast(row);
+
+    return .success;
+}
